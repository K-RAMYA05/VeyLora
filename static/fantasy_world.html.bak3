<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Arcane World</title>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
  <style>
    html, body {
      margin: 0;
      height: 100%;
      overflow: hidden;
    }
    :root {
      --overlay: rgba(15,23,42,0.78);
      --accent: #ffca5c;
      --text-main: #e5e7eb;
      --text-muted: #9ca3af;
    }
    * {
      box-sizing: border-box;
    }
    body {
      min-height: 100vh;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: var(--text-main);
      background-image: url("/image/fantasy_world.jpeg");
      background-size: contain;
      background-repeat: no-repeat;
      background-position: top center;
      background-attachment: fixed;
    }
    .veil {
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at top, rgba(15,23,42,0.35), transparent 55%),
        linear-gradient(to top, rgba(3,7,18,0.94), rgba(15,23,42,0.35));
    }
    .shell {
      position: relative;
      z-index: 1;
      max-width: 340px;
      width: 100%;
      margin: 16px;
      padding: 20px 22px 22px;
      border-radius: 24px;
      background: rgba(15,23,42,0.9);
      border: 1px solid rgba(148,163,184,0.55);
      box-shadow: 0 24px 60px rgba(0,0,0,0.9);
      position: fixed;
      right: 16px;
      top: 16px;
      bottom: 16px;
      display: flex;
      flex-direction: column;
      transform: translateX(0);
      transition: transform 180ms ease-out, opacity 180ms ease-out;
    }

    .shell-hidden {
      transform: translateX(120%);
      opacity: 0;
    }

    .shell-toggle {
      position: fixed;
      right: 16px;
      top: 50%;
      z-index: 2;
      transform: translateY(-50%);
      padding: 6px 10px;
      border-radius: 999px 0 0 999px;
      border: 1px solid rgba(148,163,184,0.7);
      background: rgba(15,23,42,0.9);
      color: var(--text-main);
      font-size: 11px;
      cursor: pointer;
      box-shadow: 0 12px 30px rgba(0,0,0,0.85);
    }
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }
    .title-block h1 {
      margin: 0;
      font-size: 22px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .title-block p {
      margin: 2px 0 0;
      font-size: 12px;
      color: var(--text-muted);
    }
    .tag {
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid rgba(148,163,184,0.7);
      font-size: 11px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .tag span {
      color: var(--accent);
    }
    .content {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr);
      gap: 14px;
    }
    @media (max-width: 900px) {
      .content {
        grid-template-columns: minmax(0, 1fr);
      }
    }
    .word-panel h2 {
      margin: 0 0 6px;
      font-size: 13px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .word {
      font-size: 28px;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      margin-bottom: 10px;
      color: var(--accent);
    }
    .word-panel p {
      margin: 0;
      font-size: 13px;
      color: var(--text-main);
    }
    .hint-panel {
      font-size: 12px;
      color: var(--text-muted);
      border-radius: 16px;
      padding: 10px 11px;
      border: 1px solid rgba(148,163,184,0.55);
      background: radial-gradient(circle at top left, rgba(15,23,42,0.94), rgba(30,64,175,0.7));
    }

    .room-modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 3;
      display: none;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at top, rgba(15,23,42,0.55), rgba(0,0,0,0.9));
      backdrop-filter: blur(10px);
    }

    .room-modal {
      max-width: 70vw;
      max-height: 70vh;
      border-radius: 20px;
      padding: 12px 12px 14px;
      background: rgba(15,23,42,0.96);
      border: 1px solid rgba(250,204,21,0.75);
      box-shadow: 0 26px 60px rgba(0,0,0,0.95);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .room-modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 4px;
    }

    .room-modal-title {
      font-size: 14px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .room-modal-close {
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 18px;
      cursor: pointer;
    }

    .room-modal-close:hover {
      color: var(--accent);
    }

    .room-image {
      width: 100%;
      max-height: 50vh;
      object-fit: contain;
      border-radius: 14px;
      border: 1px solid rgba(148,163,184,0.7);
      box-shadow: 0 18px 40px rgba(0,0,0,0.85);
    }

    .room-caption {
      font-size: 12px;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <div class="veil" aria-hidden="true"></div>
  <button class="shell-toggle" id="shellToggle" type="button">Arcade</button>
  <div class="room-modal-overlay" id="roomModal">
    <div class="room-modal">
      <div class="room-modal-header">
        <div class="room-modal-title" id="roomTitle">Room</div>
        <button class="room-modal-close" id="roomClose" aria-label="Close room view">×</button>
      </div>
      <img id="roomImage" class="room-image" alt="Selected room view"/>
      <div class="room-caption" id="roomCaption">
      </div>
    </div>
  </div>
  <div class="shell shell-hidden">
    <div class="header">
      <div class="title-block">
        <h1>The Arcane World</h1>
        <p>A dedicated screen with your fantasy world as the backdrop.</p>
      </div>
      <div class="tag">
        <span>★</span>
        Demo page using fantasy_world.jpeg
      </div>
    </div>
    <div class="content">
      <section class="word-panel">
        <h2>Your word</h2>
        <div class="word" id="worldWord">—</div>
        <p id="worldRole">
          Loading your role and hint quota in this realm...
        </p>
      </section>
      <section class="hint-panel">
        <strong>Party &amp; hints</strong>
        <p id="worldHintHelper">
          Hints will unlock after everyone has uploaded their photo and scoring is complete.
        </p>
        <ul id="partyList" style="list-style:none; padding:0; margin:6px 0 8px; font-size:11px;"></ul>
        <button id="btnRequestHint" style="margin-bottom:6px; padding:6px 10px; border-radius:999px; border:none; cursor:pointer; font-size:11px; text-transform:uppercase; letter-spacing:0.12em; background:linear-gradient(135deg,#ffca5c,#f7a600); color:#111827;">
          Request hint
        </button>
        <div id="hints" style="max-height:140px; overflow-y:auto; display:flex; flex-direction:column; gap:6px;"></div>
      </section>
    </div>
  </div>
  <script>
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get('session') || '';
    const username = params.get('name') || '';

    const wordEl = document.getElementById('worldWord');
    const roleEl = document.getElementById('worldRole');
    const helperEl = document.getElementById('worldHintHelper');
    const partyListEl = document.getElementById('partyList');
    const hintsEl = document.getElementById('hints');
    const btnHint = document.getElementById('btnRequestHint');
    const roomModalEl = document.getElementById('roomModal');
    const roomImageEl = document.getElementById('roomImage');
    const roomTitleEl = document.getElementById('roomTitle');
    const roomCaptionEl = document.getElementById('roomCaption');
    const roomCloseBtn = document.getElementById('roomClose');
    const shellToggleBtn = document.getElementById('shellToggle');
    const shellEl = document.querySelector('.shell');

    const socket = io();
    const my = { session: sessionId, name: username };
    let hintsUnlocked = true; // we only arrive here after hints_ready

    function renderParty(players) {
      partyListEl.innerHTML = '';
      players.forEach(p => {
        const li = document.createElement('li');
        const isMe = p.name === username;
        const isImposter = (p.hints_left || 0) <= 0;
        const label = isMe ? `${p.name} (you)` : p.name;
        let detail;
        if (isImposter && isMe) {
          detail = 'Imposter · no hints';
        } else if (isImposter) {
          detail = '0 hints';
        } else {
          detail = `${p.hints_left} hints`;
        }
        li.textContent = `${label} — ${detail}`;
        partyListEl.appendChild(li);
      });
    }

    function loadSessionState() {
      if (!sessionId) {
        roleEl.textContent = 'Missing session id in URL.';
        return;
      }
      fetch(`/status/${encodeURIComponent(sessionId)}`)
        .then(r => r.json())
        .then(data => {
          const players = data.players || [];
          renderParty(players);
          const me = players.find(p => p.name === username);
          if (me) {
            if (me.prompt_word) {
              wordEl.textContent = String(me.prompt_word).toUpperCase();
            }
            if (typeof me.hints_left === 'number') {
              if (me.hints_left <= 0) {
                roleEl.textContent = 'You are the imposter. You have no hints, but you can subtly twist the clues others receive.';
              } else {
                roleEl.textContent = `You have ${me.hints_left} hints in this world. Spend them wisely.`;
              }
            } else {
              roleEl.textContent = 'Your role is ready — hints are now active.';
            }
          } else {
            roleEl.textContent = 'You are in the realm as an observer.';
          }
        })
        .catch(() => {
          roleEl.textContent = 'Unable to load session state.';
        });
    }

    // Make the world background clickable everywhere outside the sidebar,
    // splitting the image into 8 regions (4 columns x 2 rows) mapped to 8 rooms.
    document.addEventListener('click', (ev) => {
      if (ev.target.closest('.shell') || ev.target.closest('#roomModal')) {
        return; // ignore clicks on the sidebar or inside the modal
      }
      const vw = window.innerWidth || document.documentElement.clientWidth;
      const vh = window.innerHeight || document.documentElement.clientHeight;
      if (!vw || !vh) return;
      const x = ev.clientX;
      const y = ev.clientY;
      const col = Math.max(0, Math.min(3, Math.floor((x / vw) * 4)));
      const row = Math.max(0, Math.min(1, Math.floor((y / vh) * 2)));
      const index = row * 4 + col; // 0..7
      const ROOM_NAMES = [
        'Great Hall',
        'Moon Library',
        'Crystal Conservatory',
        'Dungeon Labs',
        'Skyward Tower',
        'Fae Garden',
        'Astral Observatory',
        'Mirror Wing'
      ];
      const ROOM_CAPTIONS = {
        'Great Hall': 'A vast chamber of floating candles and echoing footsteps. Artifacts here tend to hide in plain sight among feasts and banners.',
        'Moon Library': 'Shelves spiral into the shadows. Relics lurk between forgotten tomes and moonlit reading alcoves.',
        'Crystal Conservatory': 'Glass domes and rare plants refract starlight; artifacts disguise themselves as crystal, root, or stone.',
        'Dungeon Labs': 'Bubbling potions and strange apparatus hum. Look for items left on benches or locked behind rusty grates.',
        'Skyward Tower': 'Wind howls around telescopes and parapets. Sky‑touched artifacts cling to ledges and rafters.',
        'Fae Garden': 'Bioluminescent flowers and winding paths conceal items under petals, moss, and trickster glamour.',
        'Astral Observatory': 'Celestial charts and brass mechanisms hide artifacts in constellations, gears, and mirrored lenses.',
        'Mirror Wing': 'Corridors of enchanted mirrors. Some reflections reveal artifacts that the corridor itself refuses to show.'
      };
      const room = ROOM_NAMES[index] || 'Unknown room';
      const id = index + 1; // 1..8
      if (roomModalEl && roomImageEl && roomTitleEl && roomCaptionEl) {
        roomImageEl.src = '/image/rooms/' + String(id) + '.png';
        roomTitleEl.textContent = room;
        roomCaptionEl.textContent = ROOM_CAPTIONS[room] || 'A mysterious chamber where artifacts may lurk in the shadows.';
        roomModalEl.style.display = 'flex';
      }
    });

    if (roomCloseBtn && roomModalEl) {
      roomCloseBtn.onclick = () => {
        roomModalEl.style.display = 'none';
      };
    }

    if (shellToggleBtn && shellEl) {
      shellToggleBtn.onclick = () => {
        shellEl.classList.toggle('shell-hidden');
      };
    }

    // Join the world view room so we receive hint responses and time updates.
    if (sessionId) {
      socket.emit('join_world_view', { session_id: sessionId });
    }

    if (btnHint) {
      btnHint.onclick = () => {
        if (!hintsUnlocked) {
          alert('Hints are not available yet.');
          return;
        }
        if (!my.session || !my.name) {
          alert('Missing session or name in URL.');
          return;
        }
        socket.emit('request_hint', { session_id: my.session, username: my.name });
      };
    }

    socket.on('hint_response', (d) => {
      if (d.error) {
        alert('Hint error: ' + d.error);
        return;
      }
      const card = document.createElement('div');
      card.style.borderRadius = '10px';
      card.style.border = '1px solid rgba(148,163,184,0.7)';
      card.style.background = 'linear-gradient(135deg, rgba(15,23,42,0.98), rgba(56,189,248,0.9))';
      card.style.padding = '8px 9px 7px';
      card.style.fontSize = '12px';
      card.style.boxShadow = '0 10px 18px rgba(15,23,42,0.85)';

      const art = document.createElement('div');
      art.style.fontSize = '11px';
      art.style.textTransform = 'uppercase';
      art.style.letterSpacing = '0.14em';
      art.style.color = 'rgba(191,219,254,0.95)';
      art.style.marginBottom = '2px';
      art.textContent = d.artifact || 'Unknown artifact';

      const text = document.createElement('div');
      text.style.fontSize = '12px';
      text.style.color = '#e5e7eb';
      text.textContent = d.clue || '';

      const meta = document.createElement('div');
      meta.style.marginTop = '4px';
      meta.style.fontSize = '10px';
      meta.style.textTransform = 'uppercase';
      meta.style.letterSpacing = '0.16em';
      meta.style.color = 'rgba(148,163,184,0.9)';
      meta.textContent = 'Hint channel · beware of illusions';

      card.appendChild(art);
      card.appendChild(text);
      card.appendChild(meta);

      hintsEl.prepend(card);
    });

    socket.on('time_tick', (d) => {
      // Optional: could display remaining time if you add an element here.
    });

    socket.on('game_over', (d) => {
      alert('Game Over: ' + (d.reason || 'check main tab for results.'));
    });

    loadSessionState();
  </script>
</body>
</html>
